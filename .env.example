# ---------------------------------------------------------------------------
# StoreForge AI — environment variables
# Copy to .env.local for development. Never commit real credentials.
# PUBLIC = inlined into the browser bundle (safe to expose)
# SECRET = server-only; never prefix with NEXT_PUBLIC_
# ---------------------------------------------------------------------------

# App ------------------------------------------------------------------------
# PUBLIC. Absolute base URL, used for auth email links and Stripe redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional. Support address shown on /contact (hidden when unset).
CONTACT_EMAIL=

# Supabase (required for auth + data) -----------------------------------------
# PUBLIC. Project URL and anon key (Project Settings → API). Access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Service-role key — bypasses RLS. Used only on the server for
# subscriptions, usage credits and rate limits.
SUPABASE_SERVICE_ROLE_KEY=

# AI (Anthropic Claude) ---------------------------------------------------------
# SECRET. Required for store generation and AI tools.
ANTHROPIC_API_KEY=
# Optional. Model and effort levels (low | medium | high | xhigh | max).
AI_MODEL=claude-opus-5-5
AI_STORE_EFFORT=medium
AI_TOOL_EFFORT=low
# Optional. Server-side refusal fallback ("off" to disable).
AI_REFUSAL_FALLBACK=default

# Stripe (required for paid plans; use test-mode keys in development) ----------
# SECRET.
STRIPE_SECRET_KEY=
# SECRET. Signing secret of your webhook endpoint (or from `stripe listen`).
STRIPE_WEBHOOK_SECRET=
# Recurring monthly Price IDs (price_...).
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Plans (optional overrides; defaults in src/lib/config/plans.ts) --------------
# Display prices must match your Stripe prices.
PLAN_CURRENCY=EUR
# PLAN_FREE_PRICE=0
# PLAN_PRO_PRICE=19
# PLAN_BUSINESS_PRICE=39
# PLAN_FREE_STORE_GENERATIONS=3
# PLAN_PRO_STORE_GENERATIONS=30
# PLAN_BUSINESS_STORE_GENERATIONS=100
# PLAN_FREE_TOOL_RUNS=15
# PLAN_PRO_TOOL_RUNS=300
# PLAN_BUSINESS_TOOL_RUNS=1000
# PLAN_FREE_PROJECTS=1
# PLAN_PRO_PROJECTS=15
# PLAN_BUSINESS_PROJECTS=75
# PLAN_FREE_PRODUCTS_PER_GENERATION=4
# PLAN_PRO_PRODUCTS_PER_GENERATION=10
# PLAN_BUSINESS_PRODUCTS_PER_GENERATION=20
